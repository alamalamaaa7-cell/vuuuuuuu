# ================================================
# UpclaseLam Backend - Environment Variables
# Salin file ini menjadi ".env" untuk development lokal.
# Untuk production di Railway, isi variabel yang sama
# lewat tab "Variables" di dashboard Railway (JANGAN upload file .env ke Railway).
# ================================================

# Port server (Railway otomatis menyediakan PORT, biarkan default di lokal)
PORT=4000

# Koneksi Database PostgreSQL.
# Di Railway: klik "+ New" -> "Database" -> "PostgreSQL", lalu copy value
# "DATABASE_URL" dari tab Variables plugin Postgres tsb ke sini (atau reference otomatis).
DATABASE_URL=postgresql://user:password@localhost:5432/upclaselam

# Secret untuk menandatangani JWT token sesi login. Ganti dengan string acak & panjang.
JWT_SECRET=ganti-dengan-string-rahasia-super-acak-minimal-32-karakter

# Google OAuth Client ID & Client Secret (dari Google Cloud Console -> Credentials).
# Client ID juga dipakai di frontend/config.js (boleh publik).
# Client Secret HANYA disimpan di backend, jangan pernah taruh di frontend.
GOOGLE_CLIENT_ID=isi-client-id-anda.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=isi-client-secret-anda

# Daftar email yang otomatis menjadi ADMIN saat login (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAILS=lamzy103@gmail.com

# Domain frontend yang boleh mengakses API ini (CORS). Untuk banyak origin, pisahkan koma.
CORS_ORIGIN=https://upclaselam.vercel.app,http://localhost:5173,http://127.0.0.1:5500
